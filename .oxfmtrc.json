{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",

	// Generated by `oxfmt --migrate=biome` from the `biome.json` this replaced
	// (ADR-0054), and unchanged since apart from the two blocks at the bottom.
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 100,
	"singleQuote": true,
	"jsxSingleQuote": false,
	"quoteProps": "as-needed",
	"trailingComma": "all",
	"semi": true,
	"arrowParens": "always",
	"bracketSameLine": false,
	"bracketSpacing": true,

	// oxfmt formats JSON, Markdown, YAML and TOML natively; Biome did not, so
	// no file of those kinds in this repo has ever been formatted by a tool.
	// Letting it would rewrite every spec, and that is a commit of its own.
	// `*.gen.ts` is TanStack Router's output — editing it is pointless.
	"ignorePatterns": ["*.json", "*.jsonc", "*.md", "*.mdx", "*.yaml", "*.yml", "*.toml", "*.gen.ts"],

	"overrides": [
		{
			// CSS keeps double quotes, which is what Biome wrote and what
			// upstream writes. `pdfTextLayer.css` is a verbatim copy of a pdf.js
			// block (ADR-0018) and its test compares the rules against the
			// installed package with the whitespace — but not the quotes —
			// dropped, so a repo-wide `'` breaks it.
			"files": ["*.css"],
			"options": { "singleQuote": false }
		}
	]
}
