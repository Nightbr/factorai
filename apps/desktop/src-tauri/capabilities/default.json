{
	"$schema": "https://schema.tauri.app/config/2/capability",
	"identifier": "default",
	"description": "Default factorai capability set",
	"windows": [
		"main"
	],
	"permissions": [
		"core:default",
		"shell:allow-open",
		"clipboard-manager:allow-write-image",
		"dialog:default",
		"fs:default",
		"process:default",
		"store:default",
		"updater:default",
		"process:allow-restart",
		"core:webview:allow-set-webview-zoom"
	]
}
