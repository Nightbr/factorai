{
	"$schema": "https://schema.tauri.app/config/2",
	"identifier": "dev.factorai",
	"productName": "factorai",
	"version": "0.1.0",
	"build": {
		"beforeDevCommand": "pnpm vite:dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm vite:build",
		"frontendDist": "../dist"
	},
	"app": {
		"withGlobalTauri": false,
		"windows": [
			{
				"title": "factorai",
				"width": 1400,
				"height": 900,
				"minWidth": 1100,
				"minHeight": 700
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"shortDescription": "Agentic Development Environment (ADE) for the AI era",
		"longDescription": "One place to build software with agents, rather than an editor with an agent bolted into a pane. The unit of work is a session, not a file: launch, watch, resume and kill Claude Code sessions, search everything they have ever said, and review what they changed in git.",
		"targets": [
			"app",
			"dmg",
			"appimage"
		],
		"macOS": {
			"hardenedRuntime": true
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"createUpdaterArtifacts": true
	},
	"plugins": {
		"shell": {
			"open": "((mailto:|tel:)[\\w+][^\\s]*|https?://\\w[^\\s]*|/[\\w.][^\\n]*)"
		},
		"updater": {
			"endpoints": [
				"https://github.com/Nightbr/factorai/releases/latest/download/latest.json"
			],
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1RTU1Q0I1MkVERkM3NjEKUldSaHg5OHV0VnpsaFJBRnRQZ1JFak4zSjJlQUVtZ0JKelRMWlVIcHpHQkhmbkxEZFozb2xKaksK"
		}
	}
}
