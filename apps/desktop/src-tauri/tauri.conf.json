{
	"$schema": "https://schema.tauri.app/config/2",
	"identifier": "dev.factorai",
	"productName": "factorai",
	"version": "0.1.0",
	"build": {
		"beforeDevCommand": "pnpm vite:dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm vite:build",
		"frontendDist": "../dist"
	},
	"app": {
		"withGlobalTauri": false,
		"windows": [
			{
				"title": "factorai",
				"width": 1400,
				"height": 900,
				"minWidth": 1100,
				"minHeight": 700
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["app", "dmg", "deb", "appimage"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"shell": {
			"open": "((mailto:|tel:)[\\w+][^\\s]*|https?://\\w[^\\s]*|/[\\w.][^\\n]*)"
		}
	}
}
