# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
target/
*.tsbuildinfo

# Turbo
.turbo/

# Tauri
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/schemas/
apps/desktop/dist/

# Editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Logs
*.log
pnpm-debug.log*

# Env
.env
.env.local
.env.*.local

# Coverage
coverage/

# Playwright
/test-results/
# Playwright writes here too when it is invoked from inside the app package
# rather than the repo root, which is easy to do by accident and lands a
# `.last-run.json` in a commit.
apps/desktop/test-results/
/playwright-report/
/playwright/.cache/
# Scratch output from the `playwright` MCP server (.mcp.json), which writes
# here when an agent drives a browser from a conversation.
/.playwright-mcp/

# pdf.js side-car assets (fonts, CMaps, WASM decoders), staged into public/ at
# startup by vite/pdfjsAssets.ts. ~4MB copied out of node_modules — it belongs
# in the build, not the history. See ADR-0018.
apps/desktop/public/pdfjs/

# Worktrees created by the agent inside the project (F21). They are checkouts
# of this same repository, so committing one would embed a git repo in itself —
# and every tool that walks the tree (biome, knip, playwright) would otherwise
# see a second copy of the whole source and report duplicates.
.claude/worktrees/
