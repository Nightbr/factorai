{
	"$schema": "https://unpkg.com/knip@5/schema.json",

	// Every `ignore*` entry below is a place knip cannot see the truth, and each
	// one says why. An ignore without a reason is how this config rotted the
	// first time: four `ignoreBinaries` and four `ignoreDependencies` outlived
	// the problems they were added for, and nobody could tell which.

	"workspaces": {
		".": {
			"entry": ["package.json"]
		},
		"apps/desktop": {
			// Colocated tests are **entry points, not ignored**. This is the
			// difference between a useful gate and a harmful one: with tests
			// invisible, anything exported solely so a test can reach it —
			// `dropIndex`, `clampImageZoom`, `orderSessions` — reads as dead, and
			// following that advice deletes the export and breaks the test.
			"entry": ["src/main.tsx", "src/**/*.test.ts"],
			"project": ["src/**/*.ts", "src/**/*.tsx"],
			"ignoreDependencies": [
				// The JS half of a plugin registered on the Rust side. Nothing in the
				// renderer imports it. `plugin-store` used to be listed here for
				// F11's `prefsStore`; F11 shipped on localStorage instead and the
				// dependency is gone (ADR-0013).
				"@tauri-apps/plugin-fs",
				// Icon data. `unplugin-icons` resolves `~icons/vscode-icons/*` and
				// `~icons/simple-icons/*` out of these at build time (ADR-0006) —
				// there is no import to find. simple-icons carries the two forge
				// marks F18's ref chips wear, which lucide has no brand set for.
				"@iconify-json/vscode-icons",
				"@iconify-json/simple-icons",
				// Loaded by `@svgr/core` at runtime when unplugin-icons compiles
				// with `compiler: 'jsx'`. A dependency of a dependency's behaviour,
				// not of our source.
				"@svgr/plugin-jsx",
				// Used from CSS — `@plugin "@tailwindcss/typography"` in
				// `src/styles/globals.css`. Knip does not parse CSS.
				"@tailwindcss/typography"
			]
		},
		"packages/ui": {
			"entry": ["src/index.ts"],
			"project": ["src/**/*.ts", "src/**/*.tsx"],
			// Imported by the Tailwind v4 CSS entry, not by any TS file.
			"ignoreDependencies": ["tailwindcss"]
		},
		"packages/types": {
			"entry": ["src/index.ts"],
			"project": ["src/**/*.ts"]
		},
		"tests": {
			"entry": ["smoke/*.spec.ts", "smoke/fixtures.ts"],
			"project": ["**/*.ts"]
		}
	},

	// **`unresolved` is off, and that costs us nothing.** It fires 64 times on
	// `~icons/vscode-icons/*` — virtual modules `unplugin-icons` creates at build
	// time (ADR-0006), which exist in Vite and nowhere on disk. knip 5.38 has no
	// `ignoreUnresolved` to narrow it with, and 64 lines of known-false output
	// every run is how a gate gets ignored.
	//
	// Turning it off is safe because knip is the *third* tool to check this and
	// the only one that can't resolve a Vite module: `tsc --noEmit` fails on an
	// unresolvable import, and `vite:build` — in CI since 902bb3c — fails on an
	// icon name unplugin-icons can't find. The check that knip does uniquely is
	// dead code, which stays on.
	"exclude": ["unresolved"],

	"ignore": [
		// Config files are read by their tools, never imported.
		"**/*.config.ts",
		"**/*.config.js",
		// Generated by TanStack Router; editing it is pointless and so is
		// auditing it.
		"apps/desktop/src/routeTree.gen.ts"
	]
}
