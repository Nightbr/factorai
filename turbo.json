{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": [
		"**/.env.*local"
	],
	"globalPassThroughEnv": [
		"XDG_DATA_DIRS",
		"XDG_DATA_HOME",
		"XDG_CONFIG_DIRS",
		"XDG_CONFIG_HOME",
		"XDG_CURRENT_DESKTOP",
		"XDG_MENU_PREFIX",
		"XDG_SESSION_TYPE",
		"XDG_RUNTIME_DIR",
		"DISPLAY",
		"WAYLAND_DISPLAY",
		"DBUS_SESSION_BUS_ADDRESS",
		"VITE_FACTORAI_SCREENSHOT",
		"SOPS_*",
		"AWS_*",
		"AZURE_*",
		"GOOGLE_*",
		"VAULT_*",
		"GNUPGHOME",
		"GPG_TTY",
		"SSH_AUTH_SOCK"
	],
	"tasks": {
		"build": {
			"dependsOn": [
				"^build"
			],
			"outputs": [
				"dist/**",
				"build/**"
			]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"lint": {
			"dependsOn": [
				"^lint"
			]
		},
		"typecheck": {
			"dependsOn": [
				"^typecheck"
			]
		},
		"test": {
			"dependsOn": [
				"^build"
			]
		}
	}
}
