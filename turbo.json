{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["**/.env.*local"],
	"globalPassThroughEnv": [
		"XDG_DATA_DIRS",
		"XDG_DATA_HOME",
		"XDG_CONFIG_DIRS",
		"XDG_CONFIG_HOME",
		"XDG_CURRENT_DESKTOP",
		"XDG_MENU_PREFIX",
		"XDG_SESSION_TYPE",
		"XDG_RUNTIME_DIR",
		"DISPLAY",
		"WAYLAND_DISPLAY",
		"DBUS_SESSION_BUS_ADDRESS"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"format": {},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"test": {
			"dependsOn": ["^build"]
		}
	}
}
