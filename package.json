{
	"name": "factorai",
	"private": true,
	"description": "Agentic Development Environment (ADE) for the AI era",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"lint": "turbo lint",
		"format": "biome format --write .",
		"format:check": "biome format . --max-diagnostics=200",
		"typecheck": "turbo typecheck",
		"test": "turbo test",
		"e2e": "playwright test",
		"e2e:ui": "playwright test --ui",
		"deps:check": "syncpack list-mismatches",
		"deps:fix": "syncpack fix-mismatches",
		"deps:unused": "knip"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@playwright/test": "1.60.0",
		"@types/node": "22.13.4",
		"knip": "5.38.2",
		"syncpack": "13.0.0",
		"turbo": "2.7.5"
	},
	"packageManager": "pnpm@10.28.0",
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=10.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": ["@biomejs/biome", "esbuild", "@playwright/test"]
	}
}
